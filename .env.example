# =============================================================================
# Analog Anime — Environment Variables
# =============================================================================
# Copy this to `.env` and fill in the values. This file is gitignored.

# --- Authentication (Better Auth) ---
BETTER_AUTH_SECRET=          # Generate with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:5173

# --- Database ---
# DATABASE_PATH=data/anime.db   # Defaults to data/anime.db if unset

# --- Sentry ---
SENTRY_DSN=                  # From https://sentry.io → Project Settings → Client Keys (DSN)
VITE_SENTRY_DSN=             # Same DSN — exposed to the browser build (DSNs are not secret)
APP_VERSION=0.1.0
VITE_APP_VERSION=0.1.0
# SENTRY_ENVIRONMENT=production # Defaults to production in build/preview, development in dev

# Source-map upload (optional — skipped when SENTRY_AUTH_TOKEN is empty)
SENTRY_ORG=                  # Sentry organisation slug
SENTRY_PROJECT=              # Sentry project slug
SENTRY_AUTH_TOKEN=           # Auth token with project:releases & org:read scopes

# --- Docker Compose (local GlitchTip) ---
# `docker compose` reads this file too. It uses SENTRY_DSN for both the server and the browser
# build, plus SENTRY_ORG, SENTRY_PROJECT and SENTRY_AUTH_TOKEN for source map uploads. Source maps
# go to http://localhost:8000 unless SENTRY_URL is set. See "Running with Docker" in README.md.
# GLITCHTIP_SECRET_KEY=        # Optional for local use. Generate with: openssl rand -hex 32
